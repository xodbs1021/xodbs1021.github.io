---
import '../styles/global.css';
import {site} from '../lib/posts.mjs';
const {title='김태윤의 엔지니어링 노트',description='백엔드와 미디어 인프라를 만들며 내린 선택, 발견한 문제, 검증한 결과를 기록합니다.',article=false,noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,site).href;
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | taeyun.blog</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="alternate" type="application/rss+xml" title="taeyun.blog" href="/index.xml"/>
{noindex&&<meta name="robots" content="noindex,follow"/>}
<meta property="og:type" content={article?'article':'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="taeyun.blog"/><meta property="og:locale" content="ko_KR"/><meta property="og:image" content={`${site}/images/taeyun-og.png`}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/>
<script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script>
</head><body><a class="skip" href="#main">본문으로 이동</a><header class="site-header"><a class="brand" href="/" aria-label="taeyun.blog 홈"><span class="brand-mark">t.</span>taeyun<span class="brand-dot">.blog</span></a><nav aria-label="주 메뉴"><a href="/posts/">글</a><a href="/series/">시리즈</a><a href="/about/">소개</a></nav><div class="header-actions"><a class="search-link" href="/search/" aria-label="글 검색"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>검색</span></a><button id="theme-toggle" class="icon-button" aria-label="밝은 화면과 어두운 화면 전환"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg></button></div></header>
<main id="main"><slot/></main><footer class="site-footer"><div><a class="brand" href="/">taeyun.blog</a><p>만들고, 확인하고, 기록합니다.</p><small>© {new Date().getFullYear()} 김태윤 · 태형이 따라잡기</small></div><nav aria-label="외부 링크"><a href="https://github.com/xodbs1021">GitHub</a><a href="https://www.linkedin.com/in/tae-yun-kim-851a02304/">LinkedIn</a><a href="/index.xml">RSS</a><a href="/privacy/">조회수 안내</a></nav></footer>
<script>document.querySelector('#theme-toggle')?.addEventListener('click',()=>{const theme=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=theme;try{localStorage.setItem('theme',theme)}catch{};window.dispatchEvent(new Event('themechange'))});</script>
</body></html>
