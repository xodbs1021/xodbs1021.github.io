---
import Base from '../../layouts/Base.astro';import PostList from '../../components/PostList.astro';import {posts,tags} from '../../lib/posts.mjs';
export function getStaticPaths(){return tags.map(tag=>({params:{tag:tag.toLowerCase().replaceAll(' ','-')},props:{tag}}))}
const {tag}=Astro.props;
---
<Base title={tag}><div class="page-shell"><header class="page-heading"><h1>{tag}</h1><p>이 주제와 연결된 기록</p></header><PostList posts={posts.filter(p=>p.tags.includes(tag))}/></div></Base>
